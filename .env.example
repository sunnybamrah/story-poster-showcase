# Placeholder names only. Set your own values in the shell or hosting environment.
# The server does not automatically load a .env file.
# Nothing here is required for `npm test` or `npm run build`.

# Local app
PORT=4317
# subscription (default: signed-in Codex CLI on this machine) or api
STORY_POSTER_GENERATION_ROUTE=subscription
# Only for the explicit API route
OPENAI_API_KEY=
STORY_POSTER_DAILY_USD=
# 1 = serve the bundled sample only, no generation
STORY_POSTER_SAMPLE_ONLY=

# Hosted mode (Railway: Postgres plus a private volume at /data)
STORY_POSTER_HOSTED=
STORY_POSTER_DATA_DIRECTORY=
DATABASE_URL=
STORY_POSTER_PUBLIC_ORIGIN=
STORY_POSTER_WORKER_SECRET=
STORY_POSTER_OWNER_EMAILS=
STORY_POSTER_OWNER_ACCOUNT_IDS=

# Email (Resend) for verification and recovery
STORY_POSTER_RESEND_KEY=
STORY_POSTER_MAIL_FROM=

# Outbound generation worker (npm run start:worker)
STORY_POSTER_WORKER_ID=

# PDF export browser
STORY_POSTER_CHROME=
STORY_POSTER_PLAYWRIGHT=

# Optional offline sample recording builder; external helper is not included
STORY_POSTER_TTS_HELPER=
